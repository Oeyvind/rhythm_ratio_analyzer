                                                    "patching_rect": [ 549.0, 171.0, 160.0, 221.0 ],
                                                    "text": "last event ratio:\ninfer the implied ratio (inter onset interval) of the last event from an expected continuation at the next whole beat, ie sum all ratios in the sequence as well as the duration of the last event, round up to the next beat and use the remainder as the ratio for the last event. if this is smaller than the smallest ratio in the sequence then add whole beats until equal or larger than the smallest ratio"
                                                }
                                            }
