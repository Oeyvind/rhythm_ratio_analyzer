                            "parameter_modmode": 3,
                            "parameter_shortname": "heat",
                            "parameter_type": 0,
                            "parameter_unitstyle": 1
                        }
                    },
                    "varname": "Temperature"
                }
            },
            {
                "box": {
                    "annotation": "Sets the number of last events to include as recent history when determining which event to generate next. Positive numbers indicate forward order and negative results in backwards ('retrograde') generation. At zero order, the probabilistic logic will find the most similar event to the one just played, repeating the same or other similar events if the temperature (heat) is high enough.",
                    "annotation_name": "Probability Order",
                    "id": "obj-243",
                    "maxclass": "live.dial",
                    "numinlets": 1,
                    "numoutlets": 2,
                    "outlettype": [ "", "float" ],
                    "parameter_enable": 1,
                    "patching_rect": [ 88.0, 142.0, 32.0, 48.0 ],
