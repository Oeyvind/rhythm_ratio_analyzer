            {
                "box": {
                    "annotation": "The temperature control determines the 'temperature' of the probability vector. Temperature can be increased to smooth the distribution an make the different probabilities more equal, or decreased to leave just the most likely event as the only candidate.",
                    "annotation_name": "Temperature",
                    "id": "obj-888",
                    "maxclass": "live.dial",
                    "numinlets": 1,
                    "numoutlets": 2,
                    "outlettype": [ "", "float" ],
                    "parameter_enable": 1,
                    "patching_rect": [ 154.0, 142.0, 32.0, 48.0 ],
                    "presentation": 1,
                    "presentation_rect": [ 98.0, 82.0, 41.0, 48.0 ],
